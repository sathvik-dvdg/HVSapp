DATABASE_URL=postgresql://postgres:postgres@db:5432/hvs_app
SECRET_KEY=replace-with-strong-secret-key
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_credentials.json
FIREBASE_CREDENTIALS_PATH=/run/secrets/gcp_credentials.json
PHI_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
CORS_ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:19006"]
REDIS_URL=redis://redis:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
DEBUG=false
